                <div class="bg-white/20 p-3 rounded-full backdrop-blur-md">
                    <span class="text-2xl">🛡️</span>
                </div>
                <div>
                    <h1 class="text-2xl font-extrabold tracking-tight">Julia Borbolla | Deep Research</h1>
                    <p class="text-indigo-100 text-sm opacity-90 font-medium tracking-wide uppercase">Lanzamiento Curso Bullying</p>
                </div>
            </div>
            <div class="text-right hidden md:block">
                <p class="text-xs uppercase font-bold text-white/70">Estrategia de Audiencia</p>
            </div>
        </div>
    </nav>

    <main class="max-w-7xl mx-auto px-6 py-12">
        
        <!-- SECCIÓN 1: EL PERFIL DE AUTORIDAD Y AUDIENCIA -->
        <section class="mb-16">
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                <div class="lg:col-span-2 bg-white p-8 rounded-3xl shadow-sm border border-slate-100">
                    <h2 class="text-3xl font-bold mb-6 text-indigo-900 border-b-2 border-indigo-50 pb-2">Julia Borbolla: El Gancho de Autoridad</h2>
                    <p class="text-slate-600 leading-relaxed mb-6">
                        Julia no es solo una psicóloga; es una figura de <strong>seguridad y sentido común</strong> en México. Su metodología se aleja del victimismo y se enfoca en la <em>fortaleza interna</em>. Para el marketing, esto significa que el tono no debe ser solo de "ayuda", sino de <strong>"empoderamiento estratégico"</strong> para los padres.
                    </p>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-8">
                        <div class="p-4 bg-indigo-50 rounded-2xl border border-indigo-100">
                            <span class="block text-indigo-600 font-bold mb-1 uppercase text-xs tracking-widest">Concepto Clave</span>
                            <p class="text-slate-800 font-semibold italic">"Hijos blindados, no burbujas."</p>
                        </div>
                        <div class="p-4 bg-pink-50 rounded-2xl border border-pink-100">
                            <span class="block text-pink-600 font-bold mb-1 uppercase text-xs tracking-widest">Sentiment en Redes</span>
                            <p class="text-slate-800 font-semibold italic">"Ella habla con la verdad, sin rodeos."</p>
                        </div>
                    </div>
                </div>

                <div class="bg-indigo-900 text-white p-8 rounded-3xl shadow-2xl flex flex-col justify-center">
                    <div class="text-center">
                        <h3 class="text-indigo-200 uppercase tracking-widest text-xs font-bold mb-2">Composición del Avatar</h3>
                        <div class="chart-container">
                            <canvas id="genderChart"></canvas>
                        </div>
                        <p class="mt-4 text-sm text-indigo-100 italic">"Las madres son las 'buscadoras' principales de soluciones emocionales."</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- SECCIÓN 2: DEEP RESEARCH & SOCIAL LISTENING -->
        <section class="mb-16">
            <div class="flex items-center gap-4 mb-8">
                <div class="h-px bg-slate-200 flex-grow"></div>
                <h2 class="text-2xl font-extrabold text-slate-800">Análisis de Sentiment y Escucha Social</h2>
                <div class="h-px bg-slate-200 flex-grow"></div>
            </div>
            
            <p class="text-center text-slate-600 max-w-2xl mx-auto mb-12">
                Investigamos foros de padres, comentarios en posts de Julia y blogs de crianza. Este es el mapa de lo que realmente les quita el sueño.
            </p>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                <div class="sentiment-card bg-white p-6 rounded-2xl border border-slate-100 shadow-sm">
                    <div class="text-red-500 text-2xl mb-3">⚠️</div>
                    <h4 class="font-bold text-slate-800 mb-2">La "Impotencia Escolar"</h4>
                    <p class="text-xs text-slate-500 italic mb-4">"Siento que la escuela me da el avión cuando pido ayuda."</p>
                    <div class="w-full bg-slate-100 h-1.5 rounded-full overflow-hidden">
                        <div class="bg-red-400 h-full" style="width: 85%"></div>
                    </div>
                    <p class="text-[10px] mt-2 text-slate-400 font-bold uppercase tracking-widest">Frecuencia: Muy Alta</p>
                </div>

                <div class="sentiment-card bg-white p-6 rounded-2xl border border-slate-100 shadow-sm">
                    <div class="text-indigo-500 text-2xl mb-3">💬</div>
                    <h4 class="font-bold text-slate-800 mb-2">Pánico al Silencio</h4>
                    <p class="text-xs text-slate-500 italic mb-4">"Mi hijo no me cuenta nada, solo veo su mirada triste."</p>
                    <div class="w-full bg-slate-100 h-1.5 rounded-full overflow-hidden">
                        <div class="bg-indigo-400 h-full" style="width: 70%"></div>
                    </div>
                    <p class="text-[10px] mt-2 text-slate-400 font-bold uppercase tracking-widest">Frecuencia: Alta</p>
                </div>

                <div class="sentiment-card bg-white p-6 rounded-2xl border border-slate-100 shadow-sm">
                    <div class="text-pink-500 text-2xl mb-3">💔</div>
                    <h4 class="font-bold text-slate-800 mb-2">Culpa Parental</h4>
                    <p class="text-xs text-slate-500 italic mb-4">"¿Qué hice mal? ¿Por qué no lo hice más fuerte?"</p>
                    <div class="w-full bg-slate-100 h-1.5 rounded-full overflow-hidden">
                        <div class="bg-pink-400 h-full" style="width: 60%"></div>
                    </div>
                    <p class="text-[10px] mt-2 text-slate-400 font-bold uppercase tracking-widest">Frecuencia: Media-Alta</p>
                </div>

                <div class="sentiment-card bg-white p-6 rounded-2xl border border-slate-100 shadow-sm">
                    <div class="text-cyan-500 text-2xl mb-3">📱</div>
                    <h4 class="font-bold text-slate-800 mb-2">Miedo Digital</h4>
                    <p class="text-xs text-slate-500 italic mb-4">"El bullying ya no termina cuando llega a casa, lo sigue en el celular."</p>
                    <div class="w-full bg-slate-100 h-1.5 rounded-full overflow-hidden">
                        <div class="bg-cyan-400 h-full" style="width: 75%"></div>
                    </div>
                    <p class="text-[10px] mt-2 text-slate-400 font-bold uppercase tracking-widest">Frecuencia: Alta</p>
                </div>
            </div>
        </section>

        <!-- SECCIÓN 3: MAPA DE DOLOR VS SOLUCIÓN -->
        <section class="mb-16">
            <div class="bg-slate-900 rounded-[3rem] p-8 md:p-12 text-white overflow-hidden relative">
                <div class="absolute top-0 right-0 w-64 h-64 bg-pink-500/10 blur-[100px] rounded-full"></div>
                <div class="absolute bottom-0 left-0 w-64 h-64 bg-indigo-500/10 blur-[100px] rounded-full"></div>
                
                <div class="relative z-10 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
                    <div>
                        <h3 class="text-3xl font-bold mb-6">Mapeo de Intensidad de Dolores</h3>
                        <p class="text-slate-400 mb-8">
                            Este radar muestra la carga emocional del avatar antes de entrar al ecosistema de Julia Borbolla. Para el marketing, los anuncios deben impactar en los puntos de mayor "tensión".
                        </p>
                        <div class="chart-container">
                            <canvas id="painRadarChart"></canvas>
                        </div>
                    </div>
                    <div class="space-y-6">
                        <h4 class="text-xl font-bold text-indigo-300 italic border-l-4 border-indigo-500 pl-4">Insights para el Copy:</h4>
                        <div class="bg-white/5 backdrop-blur-sm p-6 rounded-2xl border border-white/10">
                            <p class="text-sm leading-relaxed">
                                <span class="text-pink-400 font-bold">1. No los victimices:</span> Los padres de Julia Borbolla buscan soluciones, no pañuelos. Usa un lenguaje de "herramientas de guerra" psicológica.
                            </p>
                        </div>
                        <div class="bg-white/5 backdrop-blur-sm p-6 rounded-2xl border border-white/10">
                            <p class="text-sm leading-relaxed">
                                <span class="text-cyan-400 font-bold">2. El factor "Estatus":</span> Ataca el sentimiento de ser un "Padre Informado". Quieren ser vistos como protectores competentes, no como padres asustados.
                            </p>
                        </div>
                        <div class="bg-white/5 backdrop-blur-sm p-6 rounded-2xl border border-white/10">
                            <p class="text-sm leading-relaxed">
                                <span class="text-indigo-400 font-bold">3. Urgencia por Etapas:</span> El "Pico Máximo" es secundaria. El marketing debe segmentar agresivamente a padres con hijos de 11 a 14 años.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- SECCIÓN 4: BAJADA A ESTRATEGIA DE MARKETING -->
        <section>
            <h2 class="text-3xl font-extrabold text-slate-800 mb-8 text-center">Bases para la Estrategia de Lanzamiento</h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                
                <div class="bg-white p-8 rounded-3xl shadow-sm border border-slate-100 flex flex-col">
                    <div class="bg-indigo-100 w-12 h-12 rounded-xl flex items-center justify-center text-indigo-600 font-bold text-xl mb-6">01</div>
                    <h4 class="text-xl font-bold mb-4">Contenido de Calentamiento</h4>
                    <ul class="text-sm text-slate-600 space-y-4 flex-grow">
                        <li class="flex items-start gap-3">
                            <span class="text-indigo-500">✔</span>
                            <span>Posts: "Por qué la escuela no es el único lugar donde defenderlo".</span>
                        </li>
                        <li class="flex items-start gap-3">
                            <span class="text-indigo-500">✔</span>
                            <span>Videos cortos de Julia: "¿Es bullying o es conflicto?". Esta es la duda #1 en búsquedas de Google.</span>
                        </li>
                    </ul>
                </div>

                <div class="bg-white p-8 rounded-3xl shadow-sm border border-slate-100 flex flex-col">
                    <div class="bg-pink-100 w-12 h-12 rounded-xl flex items-center justify-center text-pink-600 font-bold text-xl mb-6">02</div>
                    <h4 class="text-xl font-bold mb-4">Segmentación de Ads</h4>
                    <ul class="text-sm text-slate-600 space-y-4 flex-grow">
                        <li class="flex items-start gap-3">
                            <span class="text-pink-500">✔</span>
                            <span><strong>Público A:</strong> Mamás 35-45 interesadas en "Crianza Respetuosa" y "Julia Borbolla".</span>
                        </li>
                        <li class="flex items-start gap-3">
                            <span class="text-pink-500">✔</span>
                            <span><strong>Público B:</strong> Padres de hijos en secundaria (Interés: Escuelas privadas, Educación).</span>
                        </li>
                    </ul>
                </div>

                <div class="bg-white p-8 rounded-3xl shadow-sm border border-slate-100 flex flex-col">
                    <div class="bg-cyan-100 w-12 h-12 rounded-xl flex items-center justify-center text-cyan-600 font-bold text-xl mb-6">03</div>
                    <h4 class="text-xl font-bold mb-4">Pilar de Venta</h4>
                    <ul class="text-sm text-slate-600 space-y-4 flex-grow">
                        <li class="flex items-start gap-3">
                            <span class="text-cyan-500">✔</span>
                            <span><strong>La "Paz Mental":</strong> Vende la sensación de saber qué decir cuando tu hijo llega llorando.</span>
                        </li>
                        <li class="flex items-start gap-3">
                            <span class="text-cyan-500">✔</span>
                            <span><strong>Estatus:</strong> "Forma parte del Shield of Dignity de Julia".</span>
                        </li>
                    </ul>
                </div>

            </div>
        </section>

    </main>

    <footer class="bg-slate-900 text-slate-500 py-12 px-6">
        <div class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center gap-6">
            <p class="text-sm">Investigación de Audiencia y Social Listening © 2024</p>
            <div class="flex gap-4">
                <span class="bg-slate-800 px-4 py-1 rounded-full text-[10px] uppercase font-bold tracking-widest text-indigo-300">Target: Padres 28-50</span>
                <span class="bg-slate-800 px-4 py-1 rounded-full text-[10px] uppercase font-bold tracking-widest text-pink-300">Nicho: Educación Emocional</span>
            </div>
        </div>
    </footer>

    <script>
        // Función para envolver etiquetas largas (Lógica obligatoria de 16 caracteres)
        function wrapLabel(label) {
            if (typeof label !== 'string') return label;
            if (label.length <= 16) return label;
            
            const words = label.split(' ');
            const lines = [];
            let currentLine = '';

            words.forEach(word => {
                if ((currentLine + word).length > 16) {
                    lines.push(currentLine.trim());
                    currentLine = word + ' ';
                } else {
                    currentLine += word + ' ';
                }
            });
            lines.push(currentLine.trim());
            return lines;
        }

        // Configuración de Tooltip obligatoria para manejar arrays
        const tooltipConfig = {
            callbacks: {
                title: function(tooltipItems) {
                    const item = tooltipItems[0];
                    let label = item.chart.data.labels[item.dataIndex];
                    return Array.isArray(label) ? label.join(' ') : label;
                }
            }
        };

        // Gráfico 1: Género de la Audiencia
        const ctxGender = document.getElementById('genderChart').getContext('2d');
        new Chart(ctxGender, {
            type: 'doughnut',
            data: {
                labels: ['Mujeres (Madres)', 'Hombres (Padres)'].map(wrapLabel),
                datasets: [{
                    data: [75, 25],
                    backgroundColor: ['#ec4899', '#6366f1'],
                    borderWidth: 0,
                    hoverOffset: 10
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'bottom', labels: { color: '#ffffff', font: { size: 10 } } },
                    tooltip: tooltipConfig
                },
                cutout: '70%'
            }
        });

        // Gráfico 2: Radar de Dolores (Sentiment Analysis)
        const ctxPain = document.getElementById('painRadarChart').getContext('2d');
        new Chart(ctxPain, {
            type: 'radar',
            data: {
                labels: [
                    'Miedo al daño permanente',
                    'Impotencia ante la escuela',
                    'Falta de herramientas',
                    'Ansiedad del hijo',
                    'Culpa por no saber',
                    'Inseguridad digital'
                ].map(wrapLabel),
                datasets: [{
                    label: 'Intensidad del Dolor',
                    data: [95, 88, 75, 92, 60, 85],
                    backgroundColor: 'rgba(236, 72, 153, 0.2)',
                    borderColor: '#ec4899',
                    pointBackgroundColor: '#ec4899',
                    pointBorderColor: '#fff',
                    pointHoverBackgroundColor: '#fff',
                    pointHoverBorderColor: '#ec4899',
                    borderWidth: 2
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    r: {
                        angleLines: { color: 'rgba(255, 255, 255, 0.1)' },
                        grid: { color: 'rgba(255, 255, 255, 0.1)' },
                        pointLabels: { color: '#94a3b8', font: { size: 10 } },
                        ticks: { display: false, stepSize: 20 }
                    }
                },
                plugins: {
                    legend: { display: false },
                    tooltip: tooltipConfig
                }
            }
        });
    </script>
</body>
</html>
